# ===================================================
# KisaanConnect — Production & Environment Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Local or Cloud DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kisaanconnect
DB_USER=postgres
DB_PASSWORD=your_secure_password
# Optional: DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional: DB_SSL=false

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Government Mandi Price API (Agmarknet / data.gov.in)
# Free registration on https://data.gov.in/
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_API_KEY=your_datagov_api_key_here

# Modular AI Service Configuration (Optional: Gemini / OpenAI)
# If no key is set, the application automatically uses a deterministic agricultural copilot engine
AI_PROVIDER=gemini
# AI_PROVIDER=openai
AI_API_KEY=your_optional_llm_api_key
AI_MODEL=gemini-1.5-flash
