{
  "name": "kisaanconnect",
  "version": "1.0.0",
  "description": "Direct farmer-to-buyer agricultural marketplace with live mandi price transparency",
  "private": true,
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install --production=false && cd server && npm install && cd ../client && npm install",
    "db:migrate": "cd server && npx sequelize-cli db:migrate",
    "db:seed": "cd server && npx sequelize-cli db:seed:all",
    "seed": "node server/scripts/seed.js",
    "test": "node test-flow.js",
    "build": "npm run install:all && cd client && npm run build",
    "start": "cd server && node server.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.33.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}